<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:Polaris.Ui.ViewModels"
             xmlns:models="using:Polaris.Ui.Models"
             xmlns:controls="using:Polaris.Ui.Controls"
             mc:Ignorable="d" d:DesignWidth="1060" d:DesignHeight="800"
             x:DataType="vm:ExploreViewModel"
             x:Class="Polaris.Ui.Views.ExploreView"
             Background="{StaticResource BgBaseBrush}">

    <DockPanel>
        <controls:TopBar DockPanel.Dock="Top"
                         Title="Explore"
                         Subtitle="Durchsuche deine Bibliothek nach Personen, Orten und Themen">
            <Border Classes="search" Width="320">
                <Grid ColumnDefinitions="Auto,8,*">
                    <PathIcon Grid.Column="0" Width="15" Height="15"
                              Foreground="{StaticResource FgMutedBrush}"
                              Data="{x:Static models:Icons.Magnify}" />
                    <TextBox Grid.Column="2" PlaceholderText="Personen, Orte, Tags…" />
                </Grid>
            </Border>
        </controls:TopBar>

        <ScrollViewer HorizontalScrollBarVisibility="Disabled">
            <StackPanel Spacing="32" Margin="28,24,28,40">
                <!-- Personen -->
                <StackPanel>
                    <DockPanel Margin="0,0,0,14">
                        <TextBlock DockPanel.Dock="Right"
                                   Text="Alle ansehen"
                                   FontSize="12"
                                   FontWeight="Medium"
                                   Foreground="{StaticResource AccentBrush}"
                                   Cursor="Hand"
                                   VerticalAlignment="Bottom" />
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <TextBlock Text="Personen" FontSize="15" FontWeight="SemiBold" Foreground="White" />
                            <TextBlock Text="{Binding PeopleSubtitle}" FontSize="11"
                                       Foreground="{StaticResource FgLabelBrush}" VerticalAlignment="Bottom" />
                        </StackPanel>
                    </DockPanel>
                    <ItemsControl ItemsSource="{Binding People}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="models:ExplorePerson">
                                <StackPanel Width="112" Margin="0,0,12,12" Cursor="Hand">
                                    <Border Width="100" Height="100"
                                            CornerRadius="50"
                                            Background="{Binding Avatar}"
                                            BoxShadow="inset 0 0 0 1 #0FFFFFFF">
                                        <TextBlock Text="{Binding Initial}"
                                                   FontSize="28"
                                                   FontWeight="Bold"
                                                   Foreground="White"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center" />
                                    </Border>
                                    <TextBlock Text="{Binding Name}"
                                               FontSize="12"
                                               FontWeight="Medium"
                                               Foreground="White"
                                               HorizontalAlignment="Center"
                                               Margin="0,8,0,0" />
                                    <TextBlock Text="{Binding Count}"
                                               FontSize="10"
                                               Foreground="{StaticResource FgMutedBrush}"
                                               HorizontalAlignment="Center" />
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>

                <!-- Orte -->
                <StackPanel>
                    <DockPanel Margin="0,0,0,14">
                        <TextBlock DockPanel.Dock="Right"
                                   Text="Alle ansehen"
                                   FontSize="12"
                                   FontWeight="Medium"
                                   Foreground="{StaticResource AccentBrush}"
                                   Cursor="Hand"
                                   VerticalAlignment="Bottom" />
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <TextBlock Text="Orte" FontSize="15" FontWeight="SemiBold" Foreground="White" />
                            <TextBlock Text="Aus den Metadaten" FontSize="11"
                                       Foreground="{StaticResource FgLabelBrush}" VerticalAlignment="Bottom" />
                        </StackPanel>
                    </DockPanel>
                    <ItemsControl ItemsSource="{Binding Places}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="models:ExplorePlace">
                                <Border Width="200" Height="125"
                                        Margin="0,0,10,10"
                                        CornerRadius="10"
                                        ClipToBounds="True"
                                        Background="{Binding Cover}"
                                        Cursor="Hand">
                                    <Panel>
                                        <!-- bottom protection gradient -->
                                        <Border IsHitTestVisible="False">
                                            <Border.Background>
                                                <LinearGradientBrush StartPoint="0%,0%" EndPoint="0%,100%">
                                                    <GradientStop Color="#00000000" Offset="0.5" />
                                                    <GradientStop Color="#B3000000" Offset="1" />
                                                </LinearGradientBrush>
                                            </Border.Background>
                                        </Border>
                                        <Border Width="24" Height="24"
                                                CornerRadius="12"
                                                Background="#66000000"
                                                HorizontalAlignment="Right"
                                                VerticalAlignment="Top"
                                                Margin="8">
                                            <PathIcon Width="12" Height="12"
                                                      Foreground="White"
                                                      Data="{x:Static models:Icons.MapMarker}" />
                                        </Border>
                                        <StackPanel VerticalAlignment="Bottom" Margin="12,0,12,10">
                                            <TextBlock Text="{Binding Name}"
                                                       FontSize="14"
                                                       FontWeight="SemiBold"
                                                       Foreground="White" />
                                            <TextBlock Text="{Binding CountText}"
                                                       FontSize="11"
                                                       Foreground="{StaticResource FgBodyBrush}"
                                                       Margin="0,1,0,0" />
                                        </StackPanel>
                                    </Panel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>

                <!-- Themen -->
                <StackPanel>
                    <DockPanel Margin="0,0,0,14">
                        <TextBlock DockPanel.Dock="Right"
                                   Text="Alle ansehen"
                                   FontSize="12"
                                   FontWeight="Medium"
                                   Foreground="{StaticResource AccentBrush}"
                                   Cursor="Hand"
                                   VerticalAlignment="Bottom" />
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <TextBlock Text="Themen" FontSize="15" FontWeight="SemiBold" Foreground="White" />
                            <TextBlock Text="Automatisch erkannt" FontSize="11"
                                       Foreground="{StaticResource FgLabelBrush}" VerticalAlignment="Bottom" />
                        </StackPanel>
                    </DockPanel>
                    <ItemsControl ItemsSource="{Binding Things}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="models:ExploreThing">
                                <Border Background="{StaticResource BgCardBrush}"
                                        BorderBrush="{StaticResource BorderSubtleBrush}"
                                        BorderThickness="1"
                                        CornerRadius="999"
                                        Padding="14,8"
                                        Margin="0,0,8,8"
                                        Cursor="Hand">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <PathIcon Width="12" Height="12"
                                                  Foreground="{StaticResource AccentBrush}"
                                                  Data="{x:Static models:Icons.Tag}" />
                                        <TextBlock Text="{Binding Name}"
                                                   FontSize="13"
                                                   FontWeight="Medium"
                                                   Foreground="White" />
                                        <TextBlock Text="{Binding Count}"
                                                   FontSize="11"
                                                   Foreground="{StaticResource FgMutedBrush}"
                                                   VerticalAlignment="Center" />
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</UserControl>
