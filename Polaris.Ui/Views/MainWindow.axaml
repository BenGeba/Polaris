<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Polaris.Ui.ViewModels"
        xmlns:models="using:Polaris.Ui.Models"
        x:Class="Polaris.Ui.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Icon="/Assets/avalonia-logo.ico"
        Title="Polaris"
        Width="1280" Height="800"
        MinWidth="900" MinHeight="600"
        Background="{StaticResource BgBaseBrush}">

    <Window.Resources>
        <!-- Sidebar nav row: icon + title. The pill/row shape comes from style classes. -->
        <DataTemplate x:Key="NavItemContent" x:DataType="models:NavigationItem">
            <Grid ColumnDefinitions="Auto,12,*,Auto">
                <PathIcon Grid.Column="0"
                          Width="18" Height="18"
                          Data="{Binding Icon, Converter={StaticResource IconKindToGeometry}}" />
                <TextBlock Grid.Column="2"
                           Text="{Binding Title}"
                           VerticalAlignment="Center" />
                <PathIcon Grid.Column="3"
                          Width="10" Height="10"
                          IsVisible="{Binding IsExpandable}"
                          Data="{x:Static models:Icons.ChevronRight}" />
            </Grid>
        </DataTemplate>
    </Window.Resources>

    <Grid ColumnDefinitions="220, *">
        <!-- ================================ Sidebar ================================ -->
        <Border Grid.Column="0"
                IsVisible="{Binding IsShellVisible}"
                Background="{StaticResource SidebarBackground}"
                BorderBrush="{StaticResource DividerBrush}"
                BorderThickness="0,0,1,0">
            <DockPanel>
                <!-- Brand: ✦ gradient tile + wordmark -->
                <StackPanel DockPanel.Dock="Top"
                            Orientation="Horizontal"
                            Spacing="10"
                            Margin="16,20,16,14">
                    <Border Width="24" Height="24"
                            CornerRadius="6"
                            Background="{StaticResource BrandGradient}">
                        <TextBlock Text="✦"
                                   FontSize="11"
                                   Foreground="White"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center" />
                    </Border>
                    <TextBlock Text="Polaris"
                               FontSize="13"
                               FontWeight="Bold"
                               LetterSpacing="0.9"
                               Foreground="White"
                               VerticalAlignment="Center" />
                </StackPanel>

                <!-- User chip -->
                <Border DockPanel.Dock="Bottom"
                        BorderBrush="{StaticResource DividerBrush}"
                        BorderThickness="0,1,0,0"
                        Padding="10">
                    <Grid ColumnDefinitions="Auto,10,*,Auto,Auto">
                        <Border Grid.Column="0"
                                Width="26" Height="26"
                                CornerRadius="13">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,100%">
                                    <GradientStop Color="#7E4E8C" Offset="0" />
                                    <GradientStop Color="#2563EB" Offset="1" />
                                </LinearGradientBrush>
                            </Border.Background>
                            <TextBlock Text="{Binding UserInitials}"
                                       FontSize="10"
                                       FontWeight="Bold"
                                       Foreground="White"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center" />
                        </Border>
                        <StackPanel Grid.Column="2" VerticalAlignment="Center">
                            <TextBlock Text="{Binding UserName}"
                                       FontSize="12"
                                       FontWeight="SemiBold"
                                       Foreground="White"
                                       TextTrimming="CharacterEllipsis" />
                            <TextBlock Text="{Binding UserServer}"
                                       FontSize="10"
                                       Foreground="{StaticResource FgMutedBrush}"
                                       TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                        <Button Grid.Column="3"
                                Classes="iconSm"
                                Command="{Binding OpenSettingsCommand}"
                                ToolTip.Tip="Einstellungen">
                            <PathIcon Data="{x:Static models:Icons.Settings}" />
                        </Button>
                        <Button Grid.Column="4"
                                Classes="iconSm"
                                Command="{Binding LogoutCommand}"
                                ToolTip.Tip="Abmelden">
                            <PathIcon Data="{x:Static models:Icons.Logout}" />
                        </Button>
                    </Grid>
                </Border>

                <!-- Storage card -->
                <Border DockPanel.Dock="Bottom" Padding="14,12,14,14">
                    <Border Background="{StaticResource BgCardBrush}"
                            CornerRadius="10"
                            Padding="14,12">
                        <StackPanel>
                            <TextBlock Text="Storage space"
                                       FontSize="12"
                                       FontWeight="Bold"
                                       Foreground="White" />
                            <TextBlock Text="{Binding StorageText}"
                                       FontSize="11"
                                       Foreground="{StaticResource FgNavBrush}"
                                       Margin="0,3,0,10" />
                            <ProgressBar Minimum="0" Maximum="100"
                                         Value="{Binding StoragePercent}"
                                         Height="4" MinHeight="4"
                                         CornerRadius="999"
                                         Background="{StaticResource BgHoverBrush}"
                                         Foreground="{StaticResource BrandGradientH}" />
                        </StackPanel>
                    </Border>
                </Border>

                <!-- Navigation groups -->
                <ScrollViewer HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="10,0">
                        <!-- Top group: Photos / Explore / Map / Sharing (pill active state) -->
                        <ItemsControl ItemsSource="{Binding TopItems}" Margin="0,0,0,8">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="models:NavigationItem">
                                    <Button Classes="nav pill"
                                            Classes.active="{Binding IsActive}"
                                            Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).NavigateCommand}"
                                            CommandParameter="{Binding}"
                                            Content="{Binding}"
                                            ContentTemplate="{StaticResource NavItemContent}" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <!-- Library group -->
                        <TextBlock Text="Library"
                                   FontSize="11"
                                   FontWeight="SemiBold"
                                   LetterSpacing="0.45"
                                   Foreground="{StaticResource GroupHeaderBrush}"
                                   Margin="12,14,12,8" />

                        <ItemsControl ItemsSource="{Binding LibraryUpperItems}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="models:NavigationItem">
                                    <Button Classes="nav"
                                            Classes.active="{Binding IsActive}"
                                            Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).NavigateCommand}"
                                            CommandParameter="{Binding}"
                                            Content="{Binding}"
                                            ContentTemplate="{StaticResource NavItemContent}" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <!-- Sub-albums under Albums -->
                        <ItemsControl ItemsSource="{Binding SubAlbums}"
                                      IsVisible="{Binding AlbumsExpanded}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="models:SubAlbum">
                                    <Button Classes="subAlbum"
                                            Classes.active="{Binding IsActive}"
                                            Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).SelectSubAlbumCommand}"
                                            CommandParameter="{Binding}">
                                        <StackPanel Orientation="Horizontal" Spacing="10">
                                            <Border Width="22" Height="22"
                                                    CornerRadius="5"
                                                    Background="{Binding Cover}" />
                                            <TextBlock Text="{Binding Title}"
                                                       VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <ItemsControl ItemsSource="{Binding LibraryLowerItems}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="models:NavigationItem">
                                    <Button Classes="nav"
                                            Classes.active="{Binding IsActive}"
                                            Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).NavigateCommand}"
                                            CommandParameter="{Binding}"
                                            Content="{Binding}"
                                            ContentTemplate="{StaticResource NavItemContent}" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </ScrollViewer>
            </DockPanel>
        </Border>

        <!-- Content Area: Login -->
        <ContentControl Grid.Column="0"
                        Grid.ColumnSpan="2"
                        IsVisible="{Binding !IsShellVisible}"
                        Content="{Binding CurrentPage}" />

        <!-- Content Area: Shell -->
        <ContentControl Grid.Column="1"
                        IsVisible="{Binding IsShellVisible}"
                        Content="{Binding CurrentPage}" />
    </Grid>

</Window>
