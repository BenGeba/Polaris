<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:Polaris.Ui.ViewModels"
             xmlns:models="using:Polaris.Ui.Models"
             xmlns:controls="using:Polaris.Ui.Controls"
             mc:Ignorable="d" d:DesignWidth="1060" d:DesignHeight="800"
             x:DataType="vm:AlbumsViewModel"
             x:Class="Polaris.Ui.Views.AlbumsView"
             Background="{StaticResource BgBaseBrush}">

    <DockPanel>
        <controls:TopBar DockPanel.Dock="Top" Title="Albums" Subtitle="{Binding Subtitle}">
            <StackPanel Orientation="Horizontal" Spacing="8">
                <Border Classes="search" Width="280">
                    <Grid ColumnDefinitions="Auto,8,*">
                        <PathIcon Grid.Column="0" Width="15" Height="15"
                                  Foreground="{StaticResource FgMutedBrush}"
                                  Data="{x:Static models:Icons.Magnify}" />
                        <TextBox Grid.Column="2" PlaceholderText="Album suchen…" />
                    </Grid>
                </Border>
                <Button Theme="{StaticResource PolarisFlatButton}"
                        Background="{StaticResource BrandGradient}"
                        CornerRadius="8"
                        Padding="14,8">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <PathIcon Width="14" Height="14"
                                  Foreground="White"
                                  Data="{x:Static models:Icons.Folder}" />
                        <TextBlock Text="Neues Album"
                                   FontSize="13"
                                   FontWeight="SemiBold"
                                   Foreground="White" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </controls:TopBar>

        <ScrollViewer HorizontalScrollBarVisibility="Disabled">
            <ItemsControl ItemsSource="{Binding Albums}" Margin="28,24,28,40">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="models:AlbumCard">
                        <StackPanel Width="220" Margin="0,0,18,18" Cursor="Hand">
                            <Panel>
                                <!-- stacked-album back edge -->
                                <Border Margin="8,8,0,0"
                                        Height="212"
                                        CornerRadius="12"
                                        Opacity="0.5"
                                        Background="{Binding BackCover}" />
                                <!-- cover -->
                                <Border Margin="0,0,8,8"
                                        Height="212"
                                        CornerRadius="12"
                                        ClipToBounds="True"
                                        Background="{Binding Cover}"
                                        BoxShadow="inset 0 0 0 1 #0AFFFFFF">
                                    <Border IsVisible="{Binding IsShared}"
                                            Background="#80000000"
                                            CornerRadius="999"
                                            Padding="8,4"
                                            HorizontalAlignment="Right"
                                            VerticalAlignment="Top"
                                            Margin="10">
                                        <StackPanel Orientation="Horizontal" Spacing="5">
                                            <PathIcon Width="11" Height="11"
                                                      Foreground="White"
                                                      Data="{x:Static models:Icons.AccountGroup}" />
                                            <TextBlock Text="Geteilt"
                                                       FontSize="10"
                                                       FontWeight="SemiBold"
                                                       Foreground="White" />
                                        </StackPanel>
                                    </Border>
                                </Border>
                            </Panel>
                            <TextBlock Text="{Binding Name}"
                                       FontSize="14"
                                       FontWeight="SemiBold"
                                       Foreground="White"
                                       TextTrimming="CharacterEllipsis"
                                       Margin="0,10,0,0" />
                            <TextBlock Text="{Binding CountText}"
                                       FontSize="11"
                                       Foreground="{StaticResource FgMutedBrush}"
                                       Margin="0,2,0,0" />
                        </StackPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </DockPanel>
</UserControl>
