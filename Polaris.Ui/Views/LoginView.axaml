<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:Polaris.Ui.ViewModels"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:DataType="vm:LoginViewModel"
             x:Class="Polaris.Ui.Views.LoginView"
             Background="#0D0D0F">
    <Grid ColumnDefinitions="*,480,*"
          RowDefinitions="*,Auto,*">

        <!-- Hintergrund Akzent — subtiler Lichteffekt oben -->
        <Ellipse Grid.Column="0" Grid.ColumnSpan="3"
                 Grid.Row="0"
                 Width="600" Height="300"
                 HorizontalAlignment="Center"
                 VerticalAlignment="Top"
                 Margin="0,-150,0,0">
            <Ellipse.Fill>
                <RadialGradientBrush>
                    <GradientStop Color="#1A3A5C" Offset="0" />
                    <GradientStop Color="#000000" Offset="1" />
                </RadialGradientBrush>
            </Ellipse.Fill>
        </Ellipse>

        <!-- Login Card -->
        <Border Grid.Column="1"
                Grid.Row="1"
                Background="#13131A"
                CornerRadius="16"
                Padding="48,40">

            <Border.BoxShadow>0 8 60 0 #40000000, inset 0 1 0 0 #22FFFFFF</Border.BoxShadow>

            <StackPanel Spacing="0">

                <!-- Logo & Titel -->
                <StackPanel HorizontalAlignment="Center"
                            Margin="0,0,0,40">

                    <!-- Stern-Icon als simples Polygon -->
                    <Border Width="52" Height="52"
                            CornerRadius="14"
                            HorizontalAlignment="Center"
                            Margin="0,0,0,16">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,100%">
                                <GradientStop Color="#2563EB" Offset="0" />
                                <GradientStop Color="#0EA5E9" Offset="1" />
                            </LinearGradientBrush>
                        </Border.Background>
                        <TextBlock Text="✦"
                                   FontSize="24"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   Foreground="White" />
                    </Border>

                    <TextBlock Text="Polaris"
                               FontSize="28"
                               FontWeight="Bold"
                               Foreground="White"
                               HorizontalAlignment="Center"
                               LetterSpacing="2" />

                    <TextBlock Text="Verbinde dich mit deiner Immich Instanz"
                               FontSize="13"
                               Foreground="#6B7280"
                               HorizontalAlignment="Center"
                               Margin="0,6,0,0" />
                </StackPanel>

                <!-- Server URL -->
                <StackPanel Spacing="6" Margin="0,0,0,16">
                    <TextBlock Text="SERVER URL"
                               FontSize="11"
                               FontWeight="SemiBold"
                               Foreground="#4B5563"
                               LetterSpacing="1.5" />

                    <Border Background="#1C1C27"
                            CornerRadius="10"
                            BorderThickness="1"
                            BorderBrush="#252535">
                        <TextBox Text="{Binding ServerUrl}"
                                 PlaceholderText="https://immich.example.com"
                                 Background="Transparent"
                                 BorderThickness="0"
                                 Foreground="White"
                                 CaretBrush="White"
                                 Padding="14,12"
                                 FontSize="14" />
                    </Border>
                </StackPanel>

                <!-- API Key -->
                <StackPanel Spacing="6" Margin="0,0,0,8">
                    <TextBlock Text="API KEY"
                               FontSize="11"
                               FontWeight="SemiBold"
                               Foreground="#4B5563"
                               LetterSpacing="1.5" />

                    <Border Background="#1C1C27"
                            CornerRadius="10"
                            BorderThickness="1"
                            BorderBrush="#252535">
                        <TextBox Text="{Binding ApiKey}"
                                 PlaceholderText="Aus den Immich Einstellungen"
                                 PasswordChar="•"
                                 Background="Transparent"
                                 BorderThickness="0"
                                 Foreground="White"
                                 CaretBrush="White"
                                 Padding="14,12"
                                 FontSize="14" />
                    </Border>
                </StackPanel>

                <!-- Fehlermeldung -->
                <Border IsVisible="{Binding ErrorMessage, 
                            Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                        Background="#2D1515"
                        CornerRadius="8"
                        Padding="12,10"
                        Margin="0,12,0,0">
                    <TextBlock Text="{Binding ErrorMessage}"
                               Foreground="#F87171"
                               FontSize="13"
                               TextWrapping="Wrap" />
                </Border>

                <!-- Login Button -->
                <Button Command="{Binding LoginCommand}"
                        HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Center"
                        Margin="0,24,0,0"
                        Padding="0,14"
                        CornerRadius="10"
                        FontSize="14"
                        FontWeight="SemiBold"
                        Foreground="White"
                        Cursor="Hand">
                    <Button.Background>
                        <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,0%">
                            <GradientStop Color="#2563EB" Offset="0" />
                            <GradientStop Color="#0EA5E9" Offset="1" />
                        </LinearGradientBrush>
                    </Button.Background>
                    <Panel>
                        <TextBlock Text="Verbinden"
                                   IsVisible="{Binding !IsLoading}" />
                        <TextBlock Text="Verbinde…"
                                   IsVisible="{Binding IsLoading}"
                                   Foreground="#A0C4FF" />
                    </Panel>
                </Button>

                <!-- Hinweis API Key -->
                <TextBlock Margin="0,20,0,0"
                           HorizontalAlignment="Center"
                           FontSize="12"
                           Foreground="#374151"
                           TextAlignment="Center">
                    <Run Text="API Key erstellen:" />
                    <Run Text="Profil → Account Settings → API Keys"
                         Foreground="#4B5563" />
                </TextBlock>

            </StackPanel>
        </Border>

    </Grid>
</UserControl>
